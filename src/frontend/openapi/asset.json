{
  "components": {
    "schemas": {
      "AssetResponse": {
        "properties": {
          "contentType": {
            "title": "Contenttype",
            "type": "string"
          },
          "failureReason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failurereason"
          },
          "fileName": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "sizeBytes": {
            "title": "Sizebytes",
            "type": "integer"
          },
          "status": {
            "enum": [
              "pending",
              "ready",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "fileName",
          "contentType",
          "sizeBytes",
          "status",
          "failureReason"
        ],
        "title": "AssetResponse",
        "type": "object"
      },
      "AttachmentMeta": {
        "description": "What a message keeps of an asset: enough to draw a chip, never a URL.",
        "properties": {
          "assetId": {
            "format": "uuid",
            "title": "Assetid",
            "type": "string"
          },
          "contentType": {
            "title": "Contenttype",
            "type": "string"
          },
          "fileName": {
            "title": "Filename",
            "type": "string"
          },
          "sizeBytes": {
            "title": "Sizebytes",
            "type": "integer"
          }
        },
        "required": [
          "assetId",
          "fileName",
          "contentType",
          "sizeBytes"
        ],
        "title": "AttachmentMeta",
        "type": "object"
      },
      "ClaimRequest": {
        "properties": {
          "assetIds": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Assetids",
            "type": "array"
          },
          "messageId": {
            "format": "uuid",
            "title": "Messageid",
            "type": "string"
          },
          "userId": {
            "format": "uuid",
            "title": "Userid",
            "type": "string"
          },
          "workspaceId": {
            "format": "uuid",
            "title": "Workspaceid",
            "type": "string"
          }
        },
        "required": [
          "workspaceId",
          "userId",
          "messageId",
          "assetIds"
        ],
        "title": "ClaimRequest",
        "type": "object"
      },
      "ClaimResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AttachmentMeta"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ClaimResponse",
        "type": "object"
      },
      "DownloadUrlRequest": {
        "properties": {
          "messageId": {
            "format": "uuid",
            "title": "Messageid",
            "type": "string"
          },
          "workspaceId": {
            "format": "uuid",
            "title": "Workspaceid",
            "type": "string"
          }
        },
        "required": [
          "workspaceId",
          "messageId"
        ],
        "title": "DownloadUrlRequest",
        "type": "object"
      },
      "DownloadUrlResponse": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "expiresAt"
        ],
        "title": "DownloadUrlResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "UploadUrlRequest": {
        "description": "Declare a file before sending it. Every field is judged by `asset.rules`.",
        "properties": {
          "contentType": {
            "title": "Contenttype",
            "type": "string"
          },
          "fileName": {
            "title": "Filename",
            "type": "string"
          },
          "purpose": {
            "title": "Purpose",
            "type": "string"
          },
          "sizeBytes": {
            "title": "Sizebytes",
            "type": "integer"
          }
        },
        "required": [
          "fileName",
          "contentType",
          "sizeBytes",
          "purpose"
        ],
        "title": "UploadUrlRequest",
        "type": "object"
      },
      "UploadUrlResponse": {
        "properties": {
          "assetId": {
            "format": "uuid",
            "title": "Assetid",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Headers",
            "type": "object"
          },
          "method": {
            "const": "PUT",
            "title": "Method",
            "type": "string"
          },
          "uploadUrl": {
            "title": "Uploadurl",
            "type": "string"
          }
        },
        "required": [
          "assetId",
          "uploadUrl",
          "method",
          "headers",
          "expiresAt"
        ],
        "title": "UploadUrlResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "CollabHub Asset",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/assets/upload-url": {
      "post": {
        "description": "Reserve an asset and sign a PUT for it. Nothing is stored yet.",
        "operationId": "request_upload_url_api_v1_assets_upload_url_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadUrlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadUrlResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Request Upload Url",
        "tags": [
          "assets"
        ]
      }
    },
    "/api/v1/assets/{asset_id}/confirm": {
      "post": {
        "description": "Check what arrived and mark the asset `ready` or `failed`.\n\n**Idempotent.** An asset that is no longer `pending` is returned as it is,\nso a retried confirm is harmless, and a `failed` asset is never re-judged\neven if bytes show up later.\n\nA missing object is `failed`, not left pending: the SPA only confirms after\nits PUT succeeded, so no object means the PUT failed (an assumed decision,\none branch to change). With the store unreachable the answer is 503 and the\nstatus is left alone, so the client can simply confirm again.",
        "operationId": "confirm_upload_api_v1_assets__asset_id__confirm_post",
        "parameters": [
          {
            "in": "path",
            "name": "asset_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Asset Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Confirm Upload",
        "tags": [
          "assets"
        ]
      }
    },
    "/api/v1/internal/assets/claim": {
      "post": {
        "description": "Put these assets on a message, or refuse them all and change nothing.\n\nThe rows are locked `FOR UPDATE` in id order, then every one is judged with\n`rules.claim_refusal` before any is written. Two sends racing for one asset\nserialize on the lock (the loser reads the winner's committed claim and is\nrefused `already-attached`), and id order means two sends naming the same\nassets in different orders cannot deadlock.",
        "operationId": "claim_assets_api_v1_internal_assets_claim_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Claim Assets",
        "tags": [
          "internal"
        ]
      }
    },
    "/api/v1/internal/assets/{asset_id}/download-url": {
      "post": {
        "description": "A short-lived read URL, if this asset is `ready` and on exactly this message.\n\nOne 404 for every miss (another workspace, another message, unclaimed, not\nready), so the answer says nothing about which.",
        "operationId": "download_url_api_v1_internal_assets__asset_id__download_url_post",
        "parameters": [
          {
            "in": "path",
            "name": "asset_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Asset Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadUrlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadUrlResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Download Url",
        "tags": [
          "internal"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ready Health Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
